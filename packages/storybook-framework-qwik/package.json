{
  "name": "@dulee.dev/storybook-framework-qwik",
  "version": "0.1.0",
  "description": "Storybook for Qwik v2 with native HMR and incremental docgen.",
  "keywords": [
    "storybook",
    "hydration",
    "resumable",
    "qwik",
    "reactive",
    "framework",
    "components",
    "builder.io"
  ],
  "type": "module",
  "//": "not sure why dist/preview is needed, but it is",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./preset": {
      "require": "./dist/preset.js",
      "import": "./dist/preset.js",
      "types": "./dist/preset.d.ts"
    },
    "./dist/preview.js": {
      "require": "./dist/preview.js",
      "import": "./dist/preview.js",
      "types": "./dist/preview.d.ts"
    },
    "./preview.js": {
      "require": "./dist/preview.js",
      "import": "./dist/preview.js",
      "types": "./dist/preview.d.ts"
    },
    "./qwik-city-decorator": {
      "require": "./dist/qwik-city-decorator.js",
      "import": "./dist/qwik-city-decorator.js",
      "types": "./dist/qwik-city-decorator.d.ts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.ts"
      ],
      "qwik-city-decorator": [
        "./dist/qwik-city-decorator.d.ts"
      ]
    }
  },
  "homepage": "https://github.com/dulee-dev/qwik-storybook-plugin",
  "bugs": {
    "url": "https://github.com/dulee-dev/qwik-storybook-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dulee-dev/qwik-storybook-plugin.git",
    "directory": "packages/storybook-framework-qwik"
  },
  "license": "MIT",
  "files": [
    "README.md",
    "./preset.js",
    "./dist/**/*.js",
    "./template/cli/**",
    "*.js",
    "*.d.ts",
    "./dist/**/*.d.ts"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "watch": "tsc --watch --outDir ./dist --listEmittedFiles",
    "build": "tsc --outDir ./dist --listEmittedFiles",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "release": "pnpm build && pnpm auto shipit"
  },
  "dependencies": {
    "@storybook/builder-vite": "^10.6.1",
    "magic-string": "^1.4.3",
    "react-docgen-typescript": "^2.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "peerDependencies": {
    "@qwik.dev/core": "2.0.0-rc.2"
  },
  "optionalDependencies": {
    "@qwik.dev/router": "2.0.0-rc.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "auto": "11.3.6",
    "storybook": "^10.6.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "literalpie <benjaminkindle@yahoo.com>",
  "auto": {
    "plugins": [
      "npm"
    ]
  }
}
