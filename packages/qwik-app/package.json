{
  "name": "qwik-app",
  "version": "0.0.0",
  "description": "App with Routing built-in (recommended)",
  "engines": {
    "node": ">=22.19.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "echo 'Run \"npm run qwik add\" to install a server adaptor'",
    "dev": "vite --mode dev",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "preview": "qwik build preview && vite preview --open",
    "start": "vite --open --mode ssr",
    "qwik": "qwik",
    "storybook": "storybook dev -p 6006",
    "storybook.build": "storybook build",
    "test-storybook": "test-storybook"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@qwik.dev/core": "2.0.0-rc.2",
    "@qwik.dev/router": "2.0.0-rc.2",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/builder-vite": "^10.6.1",
    "@storybook/test-runner": "0.26.0",
    "@types/eslint": "9.6.1",
    "@types/node": "26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "10.12.0",
    "eslint-plugin-qwik": "2.0.0-rc.2",
    "eslint-plugin-storybook": "10.6.1",
    "node-fetch": "3.3.2",
    "playwright": "1.64.0",
    "prettier": "3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.1",
    "storybook-framework-qwik": "workspace:@dulee.dev/storybook-framework-qwik@*",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "undici": "8.11.2",
    "vite": "^8.3.4"
  }
}
